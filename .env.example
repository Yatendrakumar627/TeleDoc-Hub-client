# ==========================================
# TeleDoc Hub - Client (Vite) Environment Template
# ==========================================
# Copy this file to ".env" and adjust the values:
#   PowerShell: Copy-Item .env.example .env
#
# IMPORTANT: Vite inlines every VITE_* variable into the public browser
# bundle, so these values are NOT confidential. Never put API keys,
# JWT secrets, encryption keys, bot tokens or database credentials here -
# keep those in server/.env.

# Base URL/path the frontend uses for API calls.
# Use "/api" in development so requests go through the Vite proxy.
# For production with a separate backend origin use a full URL, e.g.
# VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards "/api" requests (your Express server).
VITE_API_PROXY_TARGET=http://localhost:5000

# Vite dev server port.
VITE_DEV_SERVER_PORT=5173

# Request timeouts in milliseconds.
VITE_API_TIMEOUT=45000
VITE_UPLOAD_TIMEOUT=180000
